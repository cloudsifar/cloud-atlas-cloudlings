{
  "name": "cloud-atlas-cloudlings",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Atlas: Cloudlings — a browser game that teaches core AWS architecture at Cloud Practitioner level.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "offline:test": "node tools/offline/run-tests.mjs",
    "offline:build": "node tools/offline/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
