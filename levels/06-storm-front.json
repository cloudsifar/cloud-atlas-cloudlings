  "hints": [
    {
      "objectiveId": "through-the-storm",
      "nudge": "Watch where the kites stop after AZ a fails. Follow one in the trace: is it the fleet that cannot answer, or the database?",
      "pointer": {
        "text": "The web fleet runs only in AZ a, and so does the database. Their cards can spread each of them into AZ b.",
        "highlight": "resource:asg"
      },
      "nearAnswer": "On the web fleet's card, tick Private subnet B. On the database's card, switch on Multi-AZ. On rds-db-sg, allow MySQL 3306 from ec2-app-sg and remove the 10.0.11.0/24 rule."
    },
    {
      "objectiveId": "reads-after-failover",
      "nudge": "After the storm every instance runs in AZ b. Can they all reach the database?",
      "pointer": {
        "text": "The database's security group lists who may connect. An address range belongs to one subnet, in one zone.",
        "highlight": "resource:db"
      },
      "nearAnswer": "Switch on Multi-AZ on the database's card, and on rds-db-sg allow MySQL 3306 from ec2-app-sg instead of from 10.0.11.0/24."
    }
  ],
