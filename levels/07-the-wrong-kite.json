  "hints": [
    {
      "objectiveId": "range-at-edge",
      "nudge": "Follow the red kite from 198.51.100.66. Which rule of the public subnet's network ACL decides it, and is that the rule you meant?",
      "pointer": {
        "text": "A network ACL is read lowest number first, and the first rule that matches decides. A deny has to come before the allow it is an exception to.",
        "highlight": "subnet:public-a"
      },
      "nearAnswer": "Put both public subnets on edge-acl, and add an inbound rule there: number 90, deny All traffic from 198.51.100.0/24."
    },
    {
      "objectiveId": "script-caught",
      "nudge": "The script arrives on HTTPS 443 from an ordinary address. Which control can see what a request carries?",
      "pointer": {
        "text": "AWS WAF reads each request the load balancer accepts. Its Core rule set recognises cross-site scripting.",
        "highlight": "palette:shop-waf"
      },
      "nearAnswer": "Drag the WAF web ACL onto the load balancer and tick the Core rule set."
    },
    {
      "objectiveId": "flood-caught",
      "nudge": "Each of the flood's requests looks ordinary. What gives the flood away?",
      "pointer": {
        "text": "One address sending thousands of requests in five minutes. A WAF rate-based rule counts requests per address.",
        "highlight": "resource:shop-waf"
      },
      "nearAnswer": "On the web ACL's card, tick the rate-based rule, with a limit of 100 requests in 5 minutes."
    },
    {
      "objectiveId": "visitors-answered",
      "nudge": "Follow a green kite all the way, reply included. Where does it stop?",
      "pointer": {
        "text": "A network ACL is stateless: a request and its reply are checked separately, each against its own direction's rules.",
        "highlight": "subnet:public-a"
      },
      "nearAnswer": "On edge-acl: inbound, allow HTTPS 443 from anywhere; outbound, allow Ephemeral 1024–65535 to anywhere. Keep the two rules numbered 200 for the web servers."
    }
  ],
