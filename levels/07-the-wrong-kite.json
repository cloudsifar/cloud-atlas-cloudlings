{
  "id": 7,
  "slug": "the-wrong-kite",
  "title": "The Wrong Kite",
  "concept": "Layers of defence at the edge: a custom network ACL that denies a block-listed range before it allows HTTPS, with replies allowed out because network ACLs are stateless, and AWS WAF in front of the load balancer reading each request, to catch an attack hidden in it and a flood from one address.",
  "guidance": "hints",
  "region": "sa-east-1",
  "azs": 2,
  "lockedIds": [
