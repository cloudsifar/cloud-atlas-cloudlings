  "hints": [
    {
      "objectiveId": "uploads-land",
      "nudge": "Follow the rain from an EC2 instance to the bucket. Which check stops it?",
      "pointer": {
        "text": "The EC2 instances need permission. Permissions come from an IAM role.",
        "highlight": "palette:app-role"
      },
      "nearAnswer": "Place the bucket and the IAM role. On the role, allow s3:Write on photo-bucket. Give the role to both EC2 instances."
    },
    {
      "objectiveId": "red-blocked",
      "nudge": "A new bucket is private. Has anything changed that?",
      "pointer": {
        "text": "Open the bucket and look at Block Public Access.",
        "highlight": "resource:photos"
      },
      "nearAnswer": "Place the bucket and leave Block Public Access on, with no public statement in its policy."
    }
  ],
  "factCards": ["concept-roles-not-keys", "s3-bucket", "iam-role"],
