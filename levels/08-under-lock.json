{
  "id": 8,
  "slug": "under-lock",
  "title": "Under Lock",
  "concept": "Access control and encryption at rest are different defences: close a public bucket that holds sensitive data, then protect the data with a customer managed KMS key (SSE-KMS), which the application's role must be allowed to use, and replace an unencrypted RDS database with an encrypted copy, since RDS encrypts only at creation.",
  "guidance": "hints",
  "region": "sa-east-1",
  "azs": 2,
  "lockedIds": [
    "igw",
    "alb",
    "rt-public",
    "rt-private",
