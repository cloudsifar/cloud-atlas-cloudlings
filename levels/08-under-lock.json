  "hints": [
    {
      "objectiveId": "receipts-closed",
      "nudge": "Follow the red kite. It never enters the VPC: what lets it into the bucket?",
      "pointer": {
        "text": "A bucket is public only when Block Public Access is off and the bucket policy grants everyone. Either switch alone closes it.",
        "highlight": "resource:receipts"
      },
      "nearAnswer": "On the bucket's card, switch Block Public Access on, and untick the policy that lets everyone read."
    },
    {
      "objectiveId": "visitors-answered",
      "nudge": "Follow a green kite that uploads a receipt. Where does its rain stop?",
      "pointer": {
        "text": "With a customer managed key, S3 uses the key as the caller. The web servers' role needs permission to use it, as well as to write to the bucket.",
        "highlight": "resource:app-role"
      },
      "nearAnswer": "On app-role's card, add a statement: allow kms:Use on shop-key."
    },
    {
      "objectiveId": "receipts-own-key",
      "nudge": "SSE-S3 already encrypts every receipt. Whose key is it?",
      "pointer": {
        "text": "SSE-S3 keys belong to S3, and aws/s3 belongs to AWS. A customer managed key is a KMS key you create: drag one from the tray.",
        "highlight": "palette:shop-key"
      },
      "nearAnswer": "Place the KMS key, then set the bucket's Default encryption to SSE-KMS with shop-key."
    },
    {
      "objectiveId": "database-encrypted",
      "nudge": "The database card's encryption setting is greyed out. Why can't you just tick it?",
      "pointer": {
        "text": "RDS sets encryption only when a database is created. An unencrypted one is replaced by an encrypted copy: snapshot, copy with encryption, restore.",
        "highlight": "resource:db"
      },
      "nearAnswer": "On the database's card, choose a key and press Replace with an encrypted copy."
    }
  ],
