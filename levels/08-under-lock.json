{
  "id": 8,
  "slug": "under-lock",
  "title": "Under Lock",
  "concept": "Access control and encryption at rest are different defences, and a network edge does not cover S3: close a public bucket of sensitive data, encrypt it with a customer managed KMS key the app's role may use, and replace an unencrypted RDS database with an encrypted copy, since RDS encrypts only at creation.",
  "guidance": "hints",
  "region": "sa-east-1",
  "azs": 2,
  "lockedIds": [
    "igw",
    "alb",
