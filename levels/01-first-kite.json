  "hints": [
    {
      "objectiveId": "green-delivered",
      "nudge": "Follow a green kite's journey: where does it stop? That is the next thing to build.",
      "pointer": {
        "text": "A kite needs four things in a row: a gate, a route to it, a load balancer that allows and listens on its port, and targets behind it.",
        "highlight": "resource:alb"
      },
      "nearAnswer": "Attach the Internet Gateway. Public route table: Internet to Internet Gateway. Load balancer: inbound rule HTTPS 443 from Anywhere, listener HTTPS 443, both EC2 instances ticked as targets."
    },
    {
      "objectiveId": "red-blocked",
      "nudge": "A security group refuses anything it does not explicitly allow.",
      "pointer": {
        "text": "Look at the load balancer's inbound rules. Does anything there cover port 22?",
        "highlight": "resource:alb"
      },
      "nearAnswer": "The load balancer's security group should have exactly one inbound rule: HTTPS 443 from Anywhere. Remove any rule for SSH 22 or All traffic."
    }
  ],
