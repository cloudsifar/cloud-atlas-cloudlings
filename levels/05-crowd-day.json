  "hints": [
    {
      "objectiveId": "crowd-served",
      "nudge": "Watch the CloudWatch dial during the run. When does it reach 100%, and how many instances are serving then?",
      "pointer": {
        "text": "An Auto Scaling group adds instances when CPU climbs. Place one, give it a scaling policy, and tick it as a target on the load balancer: until it is a target, it receives no kites.",
        "highlight": "palette:asg"
      },
      "nearAnswer": "Place the Auto Scaling group. On its card set the minimum to 2, the maximum to 16 and \"Keep average CPU near 50%\". On the load balancer's card, tick the web fleet; then remove both fixed EC2 instances. New instances take two minutes to start serving, so a target of 50% or lower leaves room for the next group while they launch."
    }
  ],
