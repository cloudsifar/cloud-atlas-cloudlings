{
  "id": 5,
  "slug": "crowd-day",
  "title": "Crowd Day",
  "concept": "Elasticity: an Auto Scaling group adds capacity when a crowd arrives and removes it when the crowd leaves.",
  "guidance": "hints",
  "region": "eu-central-1",
  "azs": 2,
  "narration": [
    {
      "id": "brief",
      "text": "Word has spread. Today the usual four Cloudlings become a crowd of forty, then drift away again. Two small instances serve five kites each per tick. Fly the kites, then watch the crowd and the CloudWatch weather station.",
      "advanceWhen": {
        "kind": "run-finished"
      }
    },
    {
      "id": "task",
      "text": "Most of the crowd timed out: there was never enough capacity. You could run eight instances all day, but you would pay for all eight all day. Build a fleet that grows with the crowd and shrinks again afterwards.",
      "highlight": "palette:asg",
      "advanceWhen": {
        "kind": "acknowledged"
      }
    }
  ],
