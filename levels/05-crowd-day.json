  "hints": [
    {
      "objectiveId": "crowd-served",
      "nudge": "Open \"Tick by tick\" on the weather station. When do kites start timing out, and how many targets are in service then?",
      "pointer": {
        "text": "An Auto Scaling group can run more instances when it is busy. Drag one in, make the load balancer send requests to it, and the fixed instances are no longer needed.",
        "highlight": "palette:asg"
      },
      "nearAnswer": "Place the Auto Scaling group. On its card set the maximum to 8 and choose \"Keep average CPU near 50%\". On the load balancer's card, tick the group as a target. New instances take two ticks to start, so a lower CPU target leaves headroom while they launch."
    }
  ],
