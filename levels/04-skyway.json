  "hints": [
    {
      "objectiveId": "uploads-land",
      "nudge": "If uploads stop, open a green kite's journey and find the route step that failed.",
      "pointer": {
        "text": "The private subnets need some route that reaches S3: a NAT Gateway or an S3 gateway endpoint.",
        "highlight": "subnet:private-a"
      },
      "nearAnswer": "Click a private subnet and add the route \"S3 (prefix list) → S3 gateway endpoint\" before you remove the NAT Gateway."
    },
    {
      "objectiveId": "stays-private",
      "nudge": "A route table can send traffic for one service somewhere different from everything else.",
      "pointer": {
        "text": "Click a private subnet. Its route table offers a route for S3 only.",
        "highlight": "subnet:private-a"
      },
      "nearAnswer": "Add \"S3 (prefix list) → S3 gateway endpoint\" to the private route table. It is more specific than 0.0.0.0/0, so S3 traffic takes it. Then remove the NAT Gateway: click it and choose \"Remove from the sky\"."
    }
  ],
